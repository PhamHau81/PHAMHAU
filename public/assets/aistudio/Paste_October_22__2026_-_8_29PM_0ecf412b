    function renderQuestionInteractiveArea(q) {
      if (q.format === "multiple_choice_4") {
        return `
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            ${q.options.map(opt => `
              <button class="btn-mc-option text-left px-4 py-2.5 rounded-xl border border-slate-200 hover:border-indigo-400 hover:bg-indigo-50/50 text-sm font-medium transition flex items-center gap-3" data-qid="${q.id}" data-opt="${opt.id}">
                <span class="w-6 h-6 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center font-bold text-xs border border-slate-300">${opt.id}</span>
                <span>${opt.text}</span>
              </button>
