      });

      document.querySelectorAll(".exam-tf-radio").forEach(inp => {
        inp.addEventListener("change", (e) => {
          const qid = e.target.dataset.qid;
          const sub = e.target.dataset.sub;
          if (!state.exam.answers[qid]) state.exam.answers[qid] = {};
          state.exam.answers[qid][sub] = (e.target.value === "true");
          updateOMR(qid);
        });
      });

      document.querySelectorAll(".exam-short-input").forEach(inp => {
        inp.addEventListener("input", (e) => {
          const qid = e.target.dataset.qid;
          const val = e.target.value.trim();
          if (val) {
            state.exam.answers[qid] = val;
            updateOMR(qid);
          }
        });
      });
    }

    function startExamTimer() {
      if (state.exam.timerInterval) clearInterval(state.exam.timerInterval);
      const timerDisplay = document.getElementById("exam-timer");

      state.exam.timerInterval = setInterval(() => {
        if (state.exam.timeRemaining <= 0) {
          clearInterval(state.exam.timerInterval);
          finishExam();
          return;
        }
        state.exam.timeRemaining--;
        const mins = Math.floor(state.exam.timeRemaining / 60);
        const secs = state.exam.timeRemaining % 60;
        timerDisplay.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
      }, 1000);
    }

    function finishExam(examQuestions) {
      clearInterval(state.exam.timerInterval);
      let correctQuestions = 0;
      let totalQuestions = examQuestions.length;

      examQuestions.forEach(q => {
        const ans = state.exam.answers[q.id];
        if (q.format === "multiple_choice_4") {
          if (ans === q.correctAnswer) correctQuestions++;
        } else if (q.format === "true_false_4") {
          let allSubCorrect = true;
          if (ans) {
            q.subQuestions.forEach(sub => {
              if (ans[sub.id] !== sub.isCorrect) allSubCorrect = false;
            });
          } else {
            allSubCorrect = false;
          }
          if (allSubCorrect) correctQuestions++;
        } else if (q.format === "short_answer") {
          if (ans && ans.replace(",", ".") === q.correctAnswer.replace(",", ".")) {
            correctQuestions++;
          }
        }
      });

      const scoreOutOf10 = ((correctQuestions / totalQuestions) * 10).toFixed(1);
      const elapsed = (45 * 60) - state.exam.timeRemaining;
      const elMins = Math.floor(elapsed / 60);
      const elSecs = elapsed % 60;

      document.getElementById("res-score").textContent = `${scoreOutOf10} / 10`;
      document.getElementById("res-correct").textContent = `${correctQuestions} / ${totalQuestions}`;
      document.getElementById("res-time").textContent = `${elMins}p ${elSecs}s`;

      const modal = document.getElementById("exam-result-modal");
      modal.classList.remove("hidden");
    }
  </script>
</body>
</html>