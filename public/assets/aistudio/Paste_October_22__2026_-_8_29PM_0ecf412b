              <span class="font-bold text-amber-800"><i class="fa-solid fa-lightbulb"></i> Gợi ý cấp 1 (Ý tưởng):</span> ${q.hints[0]}
            </div>
          `;
          if (q.hints.length > 1 && btn2) {
            btn2.classList.remove("hidden");
          }
          renderAllMath();
        });
      });

      document.querySelectorAll(".btn-hint-2").forEach(btn => {
        btn.addEventListener("click", () => {
          const qid = btn.dataset.qid;
          const ch = APP_DATA[state.grade].chapters.find(c => c.id === state.currentChapterId);
          const q = ch.questions.find(item => item.id === qid);
          const box = document.getElementById(`hint-box-${qid}`);

