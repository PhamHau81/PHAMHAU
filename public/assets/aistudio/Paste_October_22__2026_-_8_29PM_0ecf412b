        btn.addEventListener("click", () => {
          const qid = btn.dataset.qid;
          const ch = APP_DATA[state.grade].chapters.find(c => c.id === state.currentChapterId);
          const q = ch.questions.find(item => item.id === qid);
          const input = document.getElementById(`input-ans-${qid}`);
          const val = input.value.trim().replace(",", ".");
          const feedback = document.getElementById(`feedback-${qid}`);

          const expected = q.correctAnswer.replace(",", ".");
          if (val === expected || Math.abs(parseFloat(val) - parseFloat(expected)) < 0.05) {
            input.classList.remove("border-rose-400", "bg-rose-50");
