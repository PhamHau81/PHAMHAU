    function attachQuestionEvents() {
      // Multiple Choice Click
      document.querySelectorAll(".btn-mc-option").forEach(btn => {
        btn.addEventListener("click", () => {
          const qid = btn.dataset.qid;
          const opt = btn.dataset.opt;
          const ch = APP_DATA[state.grade].chapters.find(c => c.id === state.currentChapterId);
          const q = ch.questions.find(item => item.id === qid);
          const feedback = document.getElementById(`feedback-${qid}`);

          const parent = btn.closest(".q-body-area");
          parent.querySelectorAll(".btn-mc-option").forEach(b => {
            b.classList.remove("bg-emerald-100", "border-emerald-500", "bg-rose-100", "border-rose-500", "text-emerald-900", "text-rose-900");
          });

          if (opt === q.correctAnswer) {
            btn.classList.add("bg-emerald-100", "border-emerald-500", "text-emerald-900");
            feedback.innerHTML = '<span class="text-emerald-600"><i class="fa-solid fa-check"></i> Chính xác! (+10đ)</span>';
            state.score += 10;
            updateScoreDisplay();
          } else {
            btn.classList.add("bg-rose-100", "border-rose-500", "text-rose-900");
            feedback.innerHTML = '<span class="text-rose-600"><i class="fa-solid fa-xmark"></i> Chưa đúng! Hãy xem gợi ý.</span>';
            // Auto add to mistakes
            addMistake(q);
          }
        });
      });

      // True False Check
      document.querySelectorAll(".btn-tf-choice").forEach(btn => {
        btn.addEventListener("click", () => {
          const qid = btn.dataset.qid;
          const sub = btn.dataset.sub;
          const val = btn.dataset.val === "true";
          const row = btn.closest("div");
          row.querySelectorAll(".btn-tf-choice").forEach(b => {
            b.classList.remove("bg-indigo-600", "text-white");
          });
          btn.classList.add("bg-indigo-600", "text-white");
          if (!state.userAnswers[qid]) state.userAnswers[qid] = {};
          state.userAnswers[qid][sub] = val;
        });
      });

      document.querySelectorAll(".btn-check-tf").forEach(btn => {
        btn.addEventListener("click", () => {
          const qid = btn.dataset.qid;
          const ch = APP_DATA[state.grade].chapters.find(c => c.id === state.currentChapterId);
          const q = ch.questions.find(item => item.id === qid);
          const userAns = state.userAnswers[qid] || {};
          let correctCount = 0;

          q.subQuestions.forEach(sub => {
            const isUserCorrect = userAns[sub.id] === sub.isCorrect;
            if (isUserCorrect) correctCount++;
          });

          const feedback = document.getElementById(`feedback-${qid}`);
          if (correctCount === 4) {
            feedback.innerHTML = `<span class="text-emerald-600"><i class="fa-solid fa-check-double"></i> Xuất sắc! Đúng cả 4 ý (+20đ)</span>`;
            state.score += 20;
            updateScoreDisplay();
          } else {
            feedback.innerHTML = `<span class="text-amber-600">Bạn làm đúng ${correctCount}/4 ý. Hãy xem lời giải chi tiết.</span>`;
            addMistake(q);
          }
        });
      });

      // Short Answer Check
