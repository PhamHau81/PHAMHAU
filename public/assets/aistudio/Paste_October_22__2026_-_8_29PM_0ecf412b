    function computeStatistics() {
      const data = state.statsData;
      let n = 0;
      let sumMC = 0;
      let cumFreq = 0;
      const processed = [];

      data.forEach((row, idx) => {
        const c_i = (row.min + row.max) / 2;
        const h_i = row.max - row.min;
        n += row.freq;
        sumMC += row.freq * c_i;
        cumFreq += row.freq;
        processed.push({
          ...row,
          c_i,
          h_i,
          cumFreq
        });
      });

      const mean = n > 0 ? (sumMC / n) : 0;

      // Median (Me)
      const halfN = n / 2;
      let medianGroup = processed.find(g => g.cumFreq >= halfN) || processed[0];
      const prevCumMed = processed[processed.indexOf(medianGroup) - 1]?.cumFreq || 0;
      const median = medianGroup.freq > 0
        ? medianGroup.min + ((halfN - prevCumMed) / medianGroup.freq) * medianGroup.h_i
        : 0;

      // Q1 (Quartile 1)
      const q1Pos = n / 4;
      let q1Group = processed.find(g => g.cumFreq >= q1Pos) || processed[0];
      const prevCumQ1 = processed[processed.indexOf(q1Group) - 1]?.cumFreq || 0;
      const q1 = q1Group.freq > 0
        ? q1Group.min + ((q1Pos - prevCumQ1) / q1Group.freq) * q1Group.h_i
        : 0;

      // Q3 (Quartile 3)
      const q3Pos = (3 * n) / 4;
      let q3Group = processed.find(g => g.cumFreq >= q3Pos) || processed[processed.length - 1];
      const prevCumQ3 = processed[processed.indexOf(q3Group) - 1]?.cumFreq || 0;
      const q3 = q3Group.freq > 0
        ? q3Group.min + ((q3Pos - prevCumQ3) / q3Group.freq) * q3Group.h_i
        : 0;

      // Mode (Mo)
      let maxFreq = -1;
      let modeGroupIdx = 0;
      processed.forEach((g, idx) => {
        if (g.freq > maxFreq) {
          maxFreq = g.freq;
          modeGroupIdx = idx;
        }
      });
      const mg = processed[modeGroupIdx];
      const prevFreq = processed[modeGroupIdx - 1]?.freq || 0;
      const nextFreq = processed[modeGroupIdx + 1]?.freq || 0;
      const d1 = mg.freq - prevFreq;
      const d2 = mg.freq - nextFreq;
      const mode = (d1 + d2 > 0) ? mg.min + (d1 / (d1 + d2)) * mg.h_i : mg.c_i;

      // Update DOM
      document.getElementById("stat-val-n").textContent = n;
      document.getElementById("stat-val-mean").textContent = mean.toFixed(2);
      document.getElementById("stat-val-median").textContent = median.toFixed(2);
      document.getElementById("stat-val-mode").textContent = mode.toFixed(2);

      document.getElementById("stat-val-q1").textContent = q1.toFixed(2);
      document.getElementById("stat-val-q2").textContent = median.toFixed(2);
      document.getElementById("stat-val-q3").textContent = q3.toFixed(2);
      document.getElementById("stat-val-iqr").textContent = (q3 - q1).toFixed(2);

      // Detailed Steps
      const stepsDiv = document.getElementById("stat-calculation-steps");
      stepsDiv.innerHTML = `
        <div class="font-bold text-slate-800 text-xs mb-1">Quy Trình Tính Toán Từng Bước:</div>
        <div>1. <b>Cỡ mẫu:</b> $n = ${processed.map(p => p.freq).join(' + ')} = ${n}$.</div>
        <div>2. <b>Số trung bình:</b> $\bar{x} = \frac{${processed.map(p => `${p.freq}\cdot${p.c_i}`).join(' + ')}}{${n}} = ${mean.toFixed(2)}$.</div>
        <div>3. <b>Trung vị:</b> Mốc $\frac{n}{2} = ${halfN}$. Nhóm chứa trung vị là $[${medianGroup.min}; ${medianGroup.max})$.</div>
        <div class="pl-3 text-indigo-700">$\Rightarrow M_e = ${medianGroup.min} + \frac{${halfN} - ${prevCumMed}}{${medianGroup.freq}} \cdot ${medianGroup.h_i} = ${median.toFixed(2)}$.</div>
        <div>4. <b>Mốt:</b> Nhóm $[${mg.min}; ${mg.max})$ có tần số lớn nhất ($m_j = ${mg.freq}$).</div>
        <div class="pl-3 text-indigo-700">$\Rightarrow M_o = ${mg.min} + \frac{${mg.freq} - ${prevFreq}}{(${mg.freq} - ${prevFreq}) + (${mg.freq} - ${nextFreq})} \cdot ${mg.h_i} = ${mode.toFixed(2)}$.</div>
      `;

      renderStatisticsChart();
      renderAllMath();
    }

    function renderStatisticsChart() {
      const ctx = document.getElementById("stat-histogram-chart");
      if (!ctx) return;

      const labels = state.statsData.map(r => `[${r.min}; ${r.max})`);
      const freqs = state.statsData.map(r => r.freq);

      if (state.chartInstance) {
        state.chartInstance.destroy();
      }

      state.chartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [{
            label: 'Tần số số liệu',
            data: freqs,
            backgroundColor: 'rgba(99, 102, 241, 0.65)',
            borderColor: 'rgba(79, 70, 229, 1)',
            borderWidth: 2,
            borderRadius: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: {
              beginAtZero: true,
              ticks: { stepSize: 2 }
            }
          },
          plugins: {
            legend: { display: false }
          }
        }
      });
    }

