<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MathConnect THPT - Tự Ôn Tập Toán Sách Kết Nối Tri Thức</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <!-- FontAwesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <!-- KaTeX -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
  <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
    body { font-family: 'Inter', sans-serif; }
    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    .katex-display { margin: 0.5em 0; overflow-x: auto; overflow-y: hidden; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

  <!-- TOP NAVBAR -->
  <header class="bg-indigo-900 text-white shadow-lg sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <!-- Brand -->
        <div class="flex items-center space-x-3 cursor-pointer" id="nav-brand-btn">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-400 to-indigo-500 flex items-center justify-center shadow-md">
            <i class="fa-solid fa-shapes text-xl text-white"></i>
          </div>
          <div>
            <div class="font-extrabold text-lg tracking-tight flex items-center gap-2">
              MathConnect <span class="text-xs bg-amber-400 text-indigo-950 font-bold px-2 py-0.5 rounded-full">KNTT THPT</span>
            </div>
            <div class="text-xs text-indigo-200">Bộ sách Kết Nối Tri Thức Với Cuộc Sống</div>
          </div>
        </div>

        <!-- Grade Selector -->
        <div class="hidden md:flex items-center bg-indigo-950/60 p-1 rounded-xl border border-indigo-700/50">
          <button class="grade-tab-btn px-4 py-1.5 rounded-lg text-sm font-semibold transition-all duration-200 text-indigo-200 hover:text-white" data-grade="10">Lớp 10</button>
          <button class="grade-tab-btn px-4 py-1.5 rounded-lg text-sm font-semibold transition-all duration-200 text-indigo-200 hover:text-white" data-grade="11">Lớp 11</button>
          <button class="grade-tab-btn px-4 py-1.5 rounded-lg text-sm font-semibold transition-all duration-200 text-indigo-200 hover:text-white" data-grade="12">Lớp 12</button>
        </div>

        <!-- User Stats & Navigation -->
        <div class="flex items-center space-x-2 sm:space-x-4">
          <div class="flex items-center gap-1.5 bg-amber-400/20 text-amber-300 border border-amber-400/30 px-3 py-1 rounded-full text-xs font-bold">
            <i class="fa-solid fa-fire text-amber-400"></i>
            <span id="streak-counter">7 ngày</span>
          </div>
          <div class="flex items-center gap-1.5 bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-3 py-1 rounded-full text-xs font-bold">
            <i class="fa-solid fa-star text-emerald-400"></i>
            <span id="score-counter">1.450 đ</span>
          </div>
          <button id="btn-toggle-mistakes" class="relative p-2 text-indigo-200 hover:text-white hover:bg-indigo-800 rounded-lg transition" title="Sổ tay câu sai">
            <i class="fa-solid fa-bookmark text-lg"></i>
            <span id="mistake-badge" class="absolute -top-1 -right-1 bg-rose-500 text-white text-[10px] w-4 h-4 rounded-full flex items-center justify-center font-bold">3</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Grade Bar -->
    <div class="flex md:hidden bg-indigo-950 px-4 py-2 border-t border-indigo-800 justify-around text-sm font-medium">
      <button class="grade-tab-btn-mobile px-3 py-1 rounded text-indigo-200 font-semibold" data-grade="10">Lớp 10</button>
      <button class="grade-tab-btn-mobile px-3 py-1 rounded text-indigo-200 font-semibold" data-grade="11">Lớp 11</button>
      <button class="grade-tab-btn-mobile px-3 py-1 rounded text-indigo-200 font-semibold" data-grade="12">Lớp 12</button>
    </div>
  </header>

  <!-- SUB NAVIGATION / TABS -->
  <nav class="bg-white border-b border-slate-200 sticky top-16 md:top-16 z-40 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex space-x-2 sm:space-x-8 overflow-x-auto py-2.5 custom-scrollbar text-sm font-semibold">
        <button id="tab-nav-practice" class="nav-mode-btn flex items-center gap-2 px-3 py-2 rounded-lg text-indigo-600 bg-indigo-50 border border-indigo-200 whitespace-nowrap transition">
          <i class="fa-solid fa-book-open"></i> Ôn Luyện Dạng Toán
        </button>
        <button id="tab-nav-statistics" class="nav-mode-btn flex items-center gap-2 px-3 py-2 rounded-lg text-slate-600 hover:bg-slate-100 whitespace-nowrap transition">
          <i class="fa-solid fa-chart-simple"></i> Công Cụ Mẫu Số Liệu & Casio
        </button>
        <button id="tab-nav-exam" class="nav-mode-btn flex items-center gap-2 px-3 py-2 rounded-lg text-slate-600 hover:bg-slate-100 whitespace-nowrap transition">
          <i class="fa-solid fa-clock"></i> Phòng Thi Ảo (Format 2025)
        </button>
        <button id="tab-nav-curriculum" class="nav-mode-btn flex items-center gap-2 px-3 py-2 rounded-lg text-slate-600 hover:bg-slate-100 whitespace-nowrap transition">
          <i class="fa-solid fa-sitemap"></i> Bản Đồ Tri Thức KNTT
        </button>
      </div>
    </div>
  </nav>

  <!-- MAIN CONTAINER -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full">

    <!-- VIEW 1: PRACTICE BY TOPIC -->
    <section id="view-practice" class="space-y-6">
      <!-- Breadcrumb & Topic Selector Bar -->
      <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="text-xs uppercase font-bold tracking-wider text-indigo-600 mb-1 flex items-center gap-1.5">
            <span id="current-grade-label">TOÁN LỚP 11</span> • BỘ SÁCH KẾT NỐI TRI THỨC VỚI CUỘC SỐNG
          </div>
          <h1 id="current-chapter-title" class="text-xl sm:text-2xl font-extrabold text-slate-900">
            Chương III: Các số đặc trưng đo xu thế trung tâm của mẫu số liệu ghép nhóm
          </h1>
        </div>

        <!-- Topic dropdown -->
        <div class="flex items-center gap-3">
          <label for="chapter-select" class="text-xs font-bold text-slate-500 whitespace-nowrap">Chọn chuyên đề:</label>
          <select id="chapter-select" class="bg-slate-100 border border-slate-300 text-slate-800 text-sm rounded-xl px-3 py-2 font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none">
            <!-- Populated dynamically via JS -->
          </select>
        </div>
      </div>

      <!-- Theory Summary Accordion / Card -->
      <div class="bg-gradient-to-br from-indigo-900 to-indigo-800 text-white p-5 sm:p-6 rounded-2xl shadow-md">
        <div class="flex items-center justify-between cursor-pointer" id="btn-toggle-theory">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-white/10 flex items-center justify-center text-amber-300">
              <i class="fa-solid fa-lightbulb text-lg"></i>
            </div>
            <div>
              <h2 class="text-lg font-bold">Tóm Tắt Công Thức & Khắc Cốt Ghi Tâm</h2>
              <p class="text-xs text-indigo-200">Nhấn để thu gọn hoặc mở rộng bảng công thức chuẩn SGK</p>
            </div>
          </div>
          <i id="theory-chevron" class="fa-solid fa-chevron-up text-indigo-300 transition-transform"></i>
        </div>
        <div id="theory-content" class="mt-4 pt-4 border-t border-indigo-700/60 text-sm leading-relaxed space-y-3">
          <!-- Theory rendered dynamically -->
        </div>
      </div>

      <!-- Filter Question Format Tabs -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1 text-xs sm:text-sm font-semibold">
        <span class="text-slate-500 mr-1 whitespace-nowrap"><i class="fa-solid fa-filter"></i> Dạng câu hỏi:</span>
        <button class="filter-format-btn px-3.5 py-1.5 rounded-full bg-indigo-600 text-white font-bold whitespace-nowrap shadow-sm" data-format="all">Tất cả (3 định dạng)</button>
        <button class="filter-format-btn px-3.5 py-1.5 rounded-full bg-slate-200 text-slate-700 hover:bg-slate-300 whitespace-nowrap" data-format="multiple_choice_4">Phần I: 4 Lựa chọn</button>
        <button class="filter-format-btn px-3.5 py-1.5 rounded-full bg-slate-200 text-slate-700 hover:bg-slate-300 whitespace-nowrap" data-format="true_false_4">Phần II: Đúng/Sai (4 ý)</button>
        <button class="filter-format-btn px-3.5 py-1.5 rounded-full bg-slate-200 text-slate-700 hover:bg-slate-300 whitespace-nowrap" data-format="short_answer">Phần III: Điền số</button>
      </div>

      <!-- Questions List Container -->
      <div id="questions-list" class="space-y-6">
        <!-- Rendered by JS -->
      </div>
    </section>

    <!-- VIEW 2: SMART STATISTICS & CASIO TOOLKIT -->
    <section id="view-statistics" class="hidden space-y-6">
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pb-6 border-b border-slate-200">
          <div>
            <div class="text-xs uppercase font-bold text-indigo-600 tracking-wider">CÔNG CỤ ĐỘC QUYỀN SÁCH KẾT NỐI TRI THỨC</div>
            <h2 class="text-2xl font-black text-slate-900 flex items-center gap-2">
              <i class="fa-solid fa-calculator text-indigo-600"></i> Trình Phân Tích Mẫu Số Liệu Ghép Nhóm
            </h2>
            <p class="text-sm text-slate-500 mt-1">Tự động tính các số đặc trưng: Trung bình, Trung vị, Tứ phân vị, Mốt, Phương sai kèm lời giải từng bước và giả lập Casio.</p>
          </div>
          <div class="flex gap-2">
            <button id="btn-sample-data-1" class="px-3 py-1.5 bg-indigo-50 text-indigo-700 hover:bg-indigo-100 rounded-lg text-xs font-bold border border-indigo-200">
              Mẫu: Giờ tự học Toán
            </button>
            <button id="btn-sample-data-2" class="px-3 py-1.5 bg-slate-100 text-slate-700 hover:bg-slate-200 rounded-lg text-xs font-bold border border-slate-300">
              Mẫu: Năng suất lúa
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mt-6">
          <!-- Left: Input Table -->
          <div class="lg:col-span-5 space-y-4">
            <h3 class="font-bold text-slate-800 text-sm flex items-center justify-between">
              <span>Bảng tần số ghép nhóm:</span>
              <button id="btn-add-stat-row" class="text-xs bg-indigo-600 text-white px-2.5 py-1 rounded-md hover:bg-indigo-700 transition">
                <i class="fa-solid fa-plus"></i> Thêm nhóm
              </button>
            </h3>

            <div class="overflow-x-auto border border-slate-200 rounded-xl">
              <table class="w-full text-left text-sm" id="stat-input-table">
                <thead class="bg-slate-100 text-slate-700 text-xs uppercase font-bold">
                  <tr>
                    <th class="p-2.5">Khoảng [a; b)</th>
                    <th class="p-2.5">Tần số (m)</th>
                    <th class="p-2.5 text-center">Xóa</th>
                  </tr>
                </thead>
                <tbody id="stat-table-body" class="divide-y divide-slate-200">
                  <!-- Populated by JS -->
                </tbody>
              </table>
            </div>

            <button id="btn-compute-statistics" class="w-full py-3 bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 text-white font-bold rounded-xl shadow-md transition flex items-center justify-center gap-2">
              <i class="fa-solid fa-wand-magic-sparkles"></i> Phân Tích & Vẽ Biểu Đồ
            </button>

            <!-- Casio Simulator Box -->
            <div class="bg-slate-900 text-white p-4 rounded-xl border border-slate-700 text-xs space-y-2">
              <div class="font-bold text-amber-400 flex items-center gap-1.5">
                <i class="fa-solid fa-microchip"></i> Hướng Dẫn Bấm Máy Tính Cầm Tay:
              </div>
              <div>
                <span class="font-semibold text-emerald-300">Casio fx-580VN X:</span> Bấm `SHIFT` $
ightarrow$ `MENU` $
ightarrow$ `phím xuống` $
ightarrow$ `3: Thống kê` $
ightarrow$ `1: Bật`. Tiếp tục bấm `MENU` $
ightarrow$ `6` $
ightarrow$ `1`. Nhập $c_i$ vào cột $x$ và $m_i$ vào cột $FREQ$ $
ightarrow$ Bấm `OPTN 2`.
              </div>
              <div>
                <span class="font-semibold text-sky-300">Casio fx-880BTG:</span> `HOME` $
ightarrow$ `Statistics` $
ightarrow$ `1-Variable` $
ightarrow$ `TOOLS` $
ightarrow$ `Frequency: On` $
ightarrow$ Nhập dữ liệu $
ightarrow$ Bấm `EXE`.
              </div>
            </div>
          </div>

          <!-- Right: Output Metrics & Chart -->
          <div class="lg:col-span-7 space-y-6">
            <!-- Metrics Cards -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
              <div class="bg-indigo-50 border border-indigo-200 p-3 rounded-xl">
                <div class="text-xs text-indigo-600 font-bold">Cỡ mẫu (n)</div>
                <div id="stat-val-n" class="text-xl font-black text-indigo-950 mt-0.5">50</div>
              </div>
              <div class="bg-amber-50 border border-amber-200 p-3 rounded-xl">
                <div class="text-xs text-amber-600 font-bold">Trung bình ($ar{x}$)</div>
                <div id="stat-val-mean" class="text-xl font-black text-amber-950 mt-0.5">10,08</div>
              </div>
              <div class="bg-emerald-50 border border-emerald-200 p-3 rounded-xl">
                <div class="text-xs text-emerald-600 font-bold">Trung vị ($M_e$)</div>
                <div id="stat-val-median" class="text-xl font-black text-emerald-950 mt-0.5">10,00</div>
              </div>
              <div class="bg-rose-50 border border-rose-200 p-3 rounded-xl">
                <div class="text-xs text-rose-600 font-bold">Mốt ($M_o$)</div>
                <div id="stat-val-mode" class="text-xl font-black text-rose-950 mt-0.5">9,85</div>
              </div>
            </div>

            <!-- Quartiles & Dispersion -->
            <div class="bg-slate-50 border border-slate-200 p-4 rounded-xl flex flex-wrap justify-between items-center text-xs gap-3 font-semibold">
              <div>Tứ phân vị $Q_1$: <span id="stat-val-q1" class="font-bold text-indigo-600 text-sm">6,83</span></div>
              <div>Tứ phân vị $Q_2$: <span id="stat-val-q2" class="font-bold text-indigo-600 text-sm">10,00</span></div>
              <div>Tứ phân vị $Q_3$: <span id="stat-val-q3" class="font-bold text-indigo-600 text-sm">13,27</span></div>
              <div>Khoảng $\Delta_Q$: <span id="stat-val-iqr" class="font-bold text-indigo-600 text-sm">6,44</span></div>
            </div>

            <!-- Chart Container -->
            <div class="bg-white p-4 border border-slate-200 rounded-xl">
              <h4 class="text-xs font-bold text-slate-600 mb-2 uppercase">Biểu Đồ Tần Số Ghép Nhóm (Histogram)</h4>
              <div class="relative h-64 w-full">
                <canvas id="stat-histogram-chart"></canvas>
              </div>
            </div>

            <!-- Detailed Steps Explanation Box -->
            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 text-xs space-y-2" id="stat-calculation-steps">
              <!-- Dynamically filled with step by step formulas -->
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- VIEW 3: MOCK EXAM SIMULATOR -->
    <section id="view-exam" class="hidden space-y-6">
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
        <!-- Exam Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-slate-200 gap-4">
          <div>
            <span class="text-xs font-bold text-rose-600 bg-rose-50 border border-rose-200 px-2.5 py-1 rounded-full uppercase">Kỳ Thi Thử Tốt Nghiệp THPT 2025</span>
            <h2 class="text-2xl font-black text-slate-900 mt-2">Đề Thi Khảo Sát Toàn Diện Môn Toán (Chuẩn Format Bộ GD&ĐT)</h2>
            <p class="text-xs text-slate-500 mt-1">Cấu trúc 3 phần: 12 câu Nhiều lựa chọn • 4 câu Đúng/Sai • 6 câu Trả lời ngắn</p>
          </div>
          <!-- Timer & Finish Button -->
          <div class="flex items-center gap-3">
            <div class="bg-slate-900 text-white px-4 py-2 rounded-xl flex items-center gap-2">
              <i class="fa-solid fa-stopwatch text-amber-400"></i>
              <span id="exam-timer" class="font-mono text-lg font-bold">45:00</span>
            </div>
            <button id="btn-submit-exam" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-5 py-2.5 rounded-xl shadow-md transition flex items-center gap-1.5 text-sm">
              <i class="fa-solid fa-paper-plane"></i> Nộp Bài
            </button>
          </div>
        </div>

        <!-- Exam Layout: Left Questions, Right OMR Map -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mt-6">
          <div class="lg:col-span-9 space-y-8" id="exam-questions-container">
            <!-- Questions rendered here -->
          </div>

          <!-- Right Floating Navigator -->
          <div class="lg:col-span-3">
            <div class="sticky top-32 bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-4">
              <h3 class="font-bold text-slate-800 text-xs uppercase tracking-wider flex items-center justify-between">
                <span>Phiếu Trả Lời (OMR)</span>
                <span id="omr-completed-count" class="text-indigo-600 font-bold">0/8 đã làm</span>
              </h3>
              <div class="text-[11px] text-slate-500">Bấm số câu để chuyển nhanh:</div>
              <div class="grid grid-cols-4 gap-2" id="omr-grid-buttons">
                <!-- Dynamically generated -->
              </div>

              <div class="pt-3 border-t border-slate-200 text-[11px] text-slate-500 space-y-1">
                <div class="flex items-center gap-2"><span class="w-3 h-3 rounded bg-indigo-600 inline-block"></span> Đã chọn</div>
                <div class="flex items-center gap-2"><span class="w-3 h-3 rounded bg-white border border-slate-300 inline-block"></span> Chưa làm</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- VIEW 4: CURRICULUM MAP -->
    <section id="view-curriculum" class="hidden space-y-6">
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
        <h2 class="text-2xl font-black text-slate-900 mb-2">Bản Đồ Cấu Trúc Khung Chương Trình KNTT (Lớp 10, 11, 12)</h2>
        <p class="text-sm text-slate-500 mb-6">Mạch kiến thức 4 trụ cột liên thông xuyên suốt 3 năm THPT.</p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Grade 10 Column -->
          <div class="border border-indigo-200 rounded-2xl p-4 bg-indigo-50/40">
            <div class="font-extrabold text-indigo-900 text-lg pb-3 border-b border-indigo-200 flex items-center justify-between">
              <span>LỚP 10 (Nền Tảng)</span>
              <span class="text-xs bg-indigo-200 text-indigo-800 px-2 py-0.5 rounded-full font-bold">9 Chương</span>
            </div>
            <ul class="mt-3 space-y-2 text-xs font-medium text-slate-700">
              <li class="p-2 bg-white rounded-lg shadow-xs">Chương I: Mệnh đề & Tập hợp</li>
              <li class="p-2 bg-white rounded-lg shadow-xs">Chương II: Bất PT bậc nhất 2 ẩn (Quy hoạch tuyến tính)</li>
              <li class="p-2 bg-white rounded-lg shadow-xs">Chương III: Hệ thức lượng trong tam giác</li>
              <li class="p-2 bg-white rounded-lg shadow-xs">Chương IV: Vectơ & Tích vô hướng</li>
              <li class="p-2 bg-white rounded-lg shadow-xs">Chương V: Thống kê không ghép nhóm & Sai số</li>
              <li class="p-2 bg-white rounded-lg shadow-xs">Chương VI: Hàm số bậc hai & Parabol</li>
              <li class="p-2 bg-white rounded-lg shadow-xs">Chương VII: Phương pháp tọa độ Oxy & 3 đường Conic</li>
              <li class="p-2 bg-white rounded-lg shadow-xs">Chương VIII: Đại số tổ hợp & Nhị thức Newton</li>
              <li class="p-2 bg-white rounded-lg shadow-xs">Chương IX: Xác suất cổ điển</li>
            </ul>
          </div>

          <!-- Grade 11 Column -->
          <div class="border border-emerald-200 rounded-2xl p-4 bg-emerald-50/40">
