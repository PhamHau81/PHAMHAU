    function switchGrade(g) {
      state.grade = g;
      document.querySelectorAll(".grade-tab-btn, .grade-tab-btn-mobile").forEach(b => {
        if (parseInt(b.dataset.grade, 10) === g) {
          b.classList.add("bg-indigo-700", "text-white");
          b.classList.remove("text-indigo-200");
        } else {
          b.classList.remove("bg-indigo-700", "text-white");
          b.classList.add("text-indigo-200");
        }
      });
      initGrade(g);
    }

    function initGrade(g) {
      const gradeData = APP_DATA[g];
      if (!gradeData) return;

      document.getElementById("current-grade-label").textContent = `TOÁN LỚP ${g}`;
      const select = document.getElementById("chapter-select");
      select.innerHTML = "";

      gradeData.chapters.forEach((ch, idx) => {
        const opt = document.createElement("option");
        opt.value = ch.id;
        opt.textContent = ch.name;
        select.appendChild(opt);
      });

      state.currentChapterId = gradeData.chapters[0].id;
      select.value = state.currentChapterId;

      select.onchange = (e) => {
        state.currentChapterId = e.target.value;
        loadChapter(state.currentChapterId);
      };

      loadChapter(state.currentChapterId);
    }

    function loadChapter(chId) {
      const ch = APP_DATA[state.grade].chapters.find(c => c.id === chId);
      if (!ch) return;

      document.getElementById("current-chapter-title").textContent = ch.name;
      document.getElementById("theory-content").innerHTML = ch.theory;
      renderQuestionsList();
      renderAllMath();
    }

